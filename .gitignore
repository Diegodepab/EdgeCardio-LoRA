# Entornos virtuales y dependencias
.venv/
venv/
ENV/
env/
uv.lock

# Archivos compilados y de caché
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Datos y Modelos (Gestionados por DVC / artefactos de entrenamiento, no por Git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/.keep
!data/processed/.gitkeep
!data/processed/.keep

models/baseline/*
models/lora_adapters/*
models/quantized/*
!models/baseline/.gitkeep
!models/baseline/.keep
!models/lora_adapters/.gitkeep
!models/lora_adapters/.keep
!models/quantized/.gitkeep
!models/quantized/.keep

# Logs y bases de datos locales
mlruns.db
mlruns/
mlartifacts/
*.log

# Entornos IDE y SO
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
